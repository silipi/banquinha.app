{
  "name": "banquinha",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test && prettier --check .",
    "format": "prettier --write .",
    "db:up": "docker compose up -d postgres",
    "db:generate": "pnpm --filter @banquinha/api db:generate",
    "db:migrate": "pnpm --filter @banquinha/api db:migrate",
    "generate": "turbo run generate",
    "db:seed": "pnpm --filter @banquinha/api db:seed"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.2"
  }
}
