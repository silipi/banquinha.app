{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "API_PORT",
    "WEB_ORIGIN",
    "ORDER_RATE_LIMIT",
    "INTERNAL_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "@vendeu/api#openapi": {
      "dependsOn": ["build"],
      "outputs": ["openapi.json"]
    },
    "@vendeu/api-client#generate": {
      "dependsOn": ["@vendeu/api#openapi"],
      "outputs": ["src/generated/**"]
    }
  }
}
