# Local Postgres (docker compose). In production: the Neon connection string.
DATABASE_URL=postgres://banquinha:banquinha@localhost:5432/banquinha

# API
API_PORT=3333
WEB_ORIGIN=http://localhost:3000
# Orders accepted per customer IP per minute (default 5).
ORDER_RATE_LIMIT=5
# Shared secret between web and API (32+ chars). Lets the web forward the customer's IP
# for rate limiting. Generate one with: openssl rand -hex 32
INTERNAL_API_KEY=

# Web
NEXT_PUBLIC_API_URL=http://localhost:3333
# Public origin of the site (canonical URLs, sitemap, share images). In production: https://banquinha.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Merchant area (login, sign-up, dashboard). Browsers resolve *.localhost to this machine.
# In production: https://minha.banquinha.app. Unset: the area lives at /painel on the site.
NEXT_PUBLIC_APP_URL=http://minha.localhost:3000

# Sign-in (all optional in development)
# OAuth client id for "Sign in with Google" (Google Cloud console > Credentials). Off when empty.
GOOGLE_CLIENT_ID=
# Resend API key for password reset emails. Empty in development: codes are printed in the API log.
RESEND_API_KEY=

# Image uploads (logos, banners, product photos) on Cloudflare R2. All five or none.
# Empty in development: the API keeps uploads in apps/api/.uploads and serves them at /api/uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public origin of the bucket (custom domain or r2.dev), no trailing slash. Also read by the
# web app to allow these images in next/image.
R2_PUBLIC_URL=
